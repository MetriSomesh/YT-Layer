# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# Create a project at https://console.neon.tech, then copy the connection
# string from Dashboard -> Connect.
#
# Use the POOLED host (it contains "-pooler") for the app and add
# `pgbouncer=true` so Prisma uses the right prepared-statement mode:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=15
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# ---------------------------------------------------------------------------
# App URL / auth
# NEXTAUTH_URL must be the public origin, e.g. https://your-app.azurewebsites.net
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
JWT_SECRET=""

# Optional: only needed if a different origin calls the API directly.
ALLOWED_ORIGIN=""

# ---------------------------------------------------------------------------
# Google OAuth (YouTube)
# Add these redirect URIs to the OAuth client in Google Cloud Console:
#   <NEXTAUTH_URL>/api/google/callback
#   <NEXTAUTH_URL>/api/upload/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
GOOGLE_UPLOAD_REDIRECT_URI="http://localhost:3000/api/upload/callback"

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# ---------------------------------------------------------------------------
# imgbb (profile picture uploads)
# ---------------------------------------------------------------------------
API_KEY=""
